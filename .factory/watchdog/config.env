# Paper Factory Watchdog — configuration
# Copied to /root/projects/paper-scion/.factory/watchdog/config.env by install.sh
# Adjust values here, then run: paper-factory watchdog-reload

# --- Project identity ---
PROJECT_DIR="/root/projects/paper-scion"
REPO="moslembabaee/paper-scion"

# --- Endpoints to watch ---
SITE_URL="https://paper.141.11.32.213.nip.io"
SCION_HUB="http://127.0.0.1:8080"
HINDSIGHT_URL="http://127.0.0.1:8888/health"

# --- Thresholds ---
# Consecutive /healthz failures before the site is called "critical".
HEALTH_FAIL_THRESHOLD=3
# Same issue dispatched more than this many times in the recent log => restart loop.
REPEAT_DISPATCH_LIMIT=5
# Deployment failures in the recent log before we escalate.
DEPLOY_FAIL_LIMIT=3
# Minutes without a new commit while approved issues are pending => no progress.
NO_PROGRESS_MINUTES=45
# Minimum free disk (MB) on the project filesystem.
DISK_FREE_MB_MIN=2000

# --- Behaviour ---
# Set to 0 to skip the (slower) server-bundle react check. It costs ~8s.
CHECK_SERVER_BUNDLE=1
# Automatic remediation. When 1, safe fixes (container restart, rollback) are
# applied without asking. When 0, everything is reported only.
AUTO_REMEDIATE=1
# Notify the owner on every finding (not only on new/changed findings).
NOTIFY_ALWAYS=0

# --- Layer 2: LLM diagnosis (only invoked when Layer 1 finds a problem) ---
# Free models, so a diagnosis costs no credits. Any OpenAI-compatible endpoint works.
# NOTE: pick a NON-reasoning model. Reasoning models (e.g. minimax-m3.1-flash-free)
# burn the whole token budget on reasoning_content and return an empty message.
LLM_BASE_URL="http://100.123.217.25:20128/v1"
LLM_MODEL="openrouter/poolside/laguna-s-2.1:free"
LLM_API_KEY_FILE="/root/.factory-secrets/llm_api_key"
# Only diagnose if a finding is at least this severe.
LLM_MIN_SEVERITY="critical"

# --- Telegram notifications ---
# Token is read from the file below (never stored in git).
TELEGRAM_TOKEN_FILE="/root/.factory-secrets/telegram_bot_token"
TELEGRAM_CHAT_ID="297868330"
